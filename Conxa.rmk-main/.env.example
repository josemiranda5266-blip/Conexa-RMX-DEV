# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RADAR_MODE: Server environment mode ("production" or "simulation")
# Default: "production"
RADAR_MODE=production

# APP_ENV: Server deployment environment ("production" or "development")
# Default: "production"
APP_ENV=production

# Marketplace monetization: percentage retained by CONEXA per completed transaction.
# Keep configurable server-side; never trust a client-supplied fee.
CONEXA_PLATFORM_FEE_PERCENT=8


# Mercado Pago Marketplace (production secrets must be stored in AI Studio Secrets)
# MP_APP_ID: App ID from Mercado Pago
MP_APP_ID="YOUR_MP_APP_ID"
# MP_CLIENT_SECRET: Secret key from Mercado Pago application
MP_CLIENT_SECRET="YOUR_MP_CLIENT_SECRET"
# 32-byte random key encoded as base64 for AES-256-GCM token encryption
MP_TOKEN_ENCRYPTION_KEY="YOUR_BASE64_32_BYTE_KEY"
# Random server-only HMAC secret used to sign OAuth state
MP_OAUTH_STATE_SECRET="YOUR_RANDOM_OAUTH_STATE_SECRET"
# Optional: Mercado Pago webhook secret for signature verification
MP_WEBHOOK_SECRET="YOUR_MP_WEBHOOK_SECRET"
