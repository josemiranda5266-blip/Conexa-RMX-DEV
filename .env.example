# Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL
APP_URL="MY_APP_URL"

# Runtime
RADAR_MODE=production
APP_ENV=production
CONEXA_PLATFORM_FEE_PERCENT=8

# Mercado Pago — server secrets only
MP_APP_ID="YOUR_MP_APP_ID"
MP_CLIENT_SECRET="YOUR_MP_CLIENT_SECRET"
MP_TOKEN_ENCRYPTION_KEY="YOUR_BASE64_32_BYTE_KEY"
MP_OAUTH_STATE_SECRET="YOUR_RANDOM_OAUTH_STATE_SECRET"
MP_WEBHOOK_SECRET="YOUR_MP_WEBHOOK_SECRET"

# Firebase Admin — configure one supported credential mechanism
FIREBASE_PROJECT_ID="conex-96e79"
FIREBASE_SERVICE_ACCOUNT=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Optional operator secrets
ADMIN_SECRET_KEY=""
RADAR_WEBHOOK_SECRET=""
