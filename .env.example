# GEMINI_API_KEY: Required for Gemini AI API calls.
# Store production secrets in the deployment secret manager; never commit real values.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL of the deployed application.
APP_URL="https://example.com"

# Server environment.
RADAR_MODE=production
APP_ENV=production

# Marketplace monetization: percentage retained by CONEXA per completed transaction.
CONEXA_PLATFORM_FEE_PERCENT=8

# Firebase Admin SDK (one of these must be configured in the deployment environment).
# FIREBASE_SERVICE_ACCOUNT may contain the service-account JSON or its Base64 encoding.
FIREBASE_SERVICE_ACCOUNT=
# Alternative: filesystem path to the service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# Internal Conexa/Nexora event-processing endpoint. Generate a long random secret and
# store it only in the deployment secret manager; never expose it to the web client.
INTERNAL_EVENT_SECRET=

# Scheduled outbox worker configuration.
# SCHEDULE follows Firebase Scheduler syntax, e.g. "every 5 minutes".
NEXORA_OUTBOX_SCHEDULE="every 5 minutes"
NEXORA_OUTBOX_BATCH_LIMIT=20
NEXORA_OUTBOX_MAX_INSTANCES=1

# Scheduled escrow auto-release worker configuration.
NEXORA_ESCROW_SCHEDULE="every 15 minutes"
NEXORA_ESCROW_BATCH_LIMIT=100
NEXORA_ESCROW_MAX_INSTANCES=1

# Scheduled chargeback expiry worker configuration.
NEXORA_CHARGEBACK_EXPIRY_SCHEDULE="every 15 minutes"
NEXORA_CHARGEBACK_EXPIRY_MAX_INSTANCES=1

# Mercado Pago Marketplace (production secrets must be stored in the deployment secret manager).
MP_APP_ID=
MP_CLIENT_SECRET=
# Base64 encoding of exactly 32 random bytes for AES-256-GCM token encryption.
MP_TOKEN_ENCRYPTION_KEY=
# Server-only HMAC secret used to sign OAuth state.
MP_OAUTH_STATE_SECRET=
# Server-only webhook secret used for HMAC signature verification.
MP_WEBHOOK_SECRET=

# Meta webhook configuration. Keep the verification token in the deployment secret manager.
META_VERIFY_TOKEN=
# Optional: Meta webhook application secret used to verify signed requests.
META_APP_SECRET=
