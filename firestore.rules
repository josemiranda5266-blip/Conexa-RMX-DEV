rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if professional flags are unchanged by self-update
    function isNotModifyingPrivileges() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'isProfessional', 'hasProfessionalProfile', 'isProfessionalVerified']);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (resource == null || isNotModifyingPrivileges());
    }

    // Service Requests collection
    match /service_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.clientId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quotesCount', 'status']));
    }

    // Quotes collection
    match /quotes/{quoteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.professionalId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.professionalId == request.auth.uid;
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.clientId == request.auth.uid || resource.data.professionalId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.clientId == request.auth.uid || request.resource.data.professionalId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.clientId == request.auth.uid || resource.data.professionalId == request.auth.uid);
    }

    // Helper for chat participant verification
    function isChatParticipant() {
      return isAuthenticated() && (
        resource == null ||
        resource.data.clientId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        (resource.data.participantIds != null && resource.data.participantIds.hasAny([request.auth.uid]))
      );
    }

    function isChatParticipantForCreate() {
      return isAuthenticated() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.professionalId == request.auth.uid ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        (request.resource.data.participantIds != null && request.resource.data.participantIds.hasAny([request.auth.uid]))
      );
    }

    // Chats collection
    match /chats/{chatId} {
      allow read: if isChatParticipant();
      allow create: if isChatParticipantForCreate();
      allow update: if isChatParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.professionalId == request.auth.uid ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds != null && get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAny([request.auth.uid]))
        );
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.professionalId == request.auth.uid ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds != null && get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAny([request.auth.uid]))
        );
        allow update, delete: if false;
      }
    }
  }
}
