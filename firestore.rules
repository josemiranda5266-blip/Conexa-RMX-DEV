rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }

    // Admins Collection - Restricted
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // Public Users profiles (No phone or exact address)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) 
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'USER' || request.resource.data.role == 'PROFESSIONAL')
        && (!request.resource.data.keys().hasAny(['activeMode']) || request.resource.data.activeMode != 'ADMIN');
      
      // Prevent role & privilege tampering on update
      allow update: if isAdmin() || (
        isOwner(userId) 
        && request.resource.data.role == resource.data.role
        && (!request.resource.data.keys().hasAny(['activeMode']) || request.resource.data.activeMode != 'ADMIN')
        && (!resource.data.keys().hasAny(['isIdentityVerified']) || request.resource.data.isIdentityVerified == resource.data.isIdentityVerified)
        && (!resource.data.keys().hasAny(['isProfessionalVerified']) || request.resource.data.isProfessionalVerified == resource.data.isProfessionalVerified)
      );
      allow delete: if isAdmin();

      // Confidential Private Info (Phone, Exact Address, ID docs) - Restricted strictly to owner or admin
      match /private/info {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Service Requests - Restricted to Client Owner, Bidding/Assigned Professionals, or Admins
    match /service_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        (resource.data.assignedProfessionalId != null && resource.data.assignedProfessionalId == request.auth.uid) ||
        (resource.data.biddingProfessionalIds != null && request.auth.uid in resource.data.biddingProfessionalIds) ||
        resource.data.status == 'OPEN' ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || isAdmin()
      );
    }

    // Quotes - Confidential between Professional, Client and Admin
    match /quotes/{quoteId} {
      allow read: if isSignedIn() && (
        resource.data.professionalId == request.auth.uid || 
        resource.data.clientId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.professionalId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.professionalId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Conversations & Messages - Strictly between participants
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId ||
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds) ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
    }

    // Moderation & Safety Reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Verification Requests
    match /verifications/{verifId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // CONEXA RADAR Demand Opportunities - Restricted to Admins
    match /radar_opportunities/{opportunityId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Immutable Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Beta System Config & Invite Codes
    match /beta_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /invite_codes/{codeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
